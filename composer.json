{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "xdamman/selection-sharer",
                "version": "1.2.2",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/xdamman/selection-sharer/archive/refs/heads/master.zip",
                    "type": "zip"
                }
            }
        },
        {
          "type": "composer",
          "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/account_modal": "1.0-beta3",
        "drupal/address": "^1.9",
        "drupal/addtoany": "^1.14",
        "drupal/admin_toolbar": "^3.0",
        "drupal/backup_migrate": "5.0.0-rc2",
        "drupal/better_emails": "^1.0",
        "drupal/better_exposed_filters": "5.x-dev",
        "drupal/blockgroup": "^1.5",
        "drupal/change_pwd_page": "^1.0",
        "drupal/chosen": "3.0.1",
        "drupal/ckeditor_media_embed": "^1.10",
        "drupal/ckeditor_oembed": "^1.3",
        "drupal/colorbutton": "^1.2",
        "drupal/comment_reply_count": "^1.2",
        "drupal/commerce": "^2.24",
        "drupal/commerce_cart_redirection": "^3.0",
        "drupal/commerce_checkout_order_fields": "^1.1",
        "drupal/commerce_paypal": "^1.0@RC",
        "drupal/commerce_product_limits": "^1.0",
        "drupal/computed_field": "3.x-dev@dev",
        "drupal/config_ignore": "^2.3",
        "drupal/console": "~1.0",
        "drupal/context": "4.0-beta5",
        "drupal/core-composer-scaffold": "^9.1",
        "drupal/core-project-message": "^9.1",
        "drupal/core-recommended": "^9.1",
        "drupal/country_state_field": "1.x-dev@dev",
        "drupal/cshs": "^2.3",
        "drupal/datalayer": "^1.0@beta",
        "drupal/devel": "^4.1",
        "drupal/devel_kint_extras": "^1.0",
        "drupal/devel_php": "^1.3",
        "drupal/ds": "^3.10",
        "drupal/easy_breadcrumb": "^1.15",
        "drupal/email_registration": "^1.1",
        "drupal/entity_embed": "^1.1",
        "drupal/facets": "^1.7",
        "drupal/field_formatter_class": "^1.5",
        "drupal/field_group": "^3.1",
        "drupal/fixed_block_content": "^1.1",
        "drupal/fontawesome": "^2.18",
        "drupal/gamw": "^1.1",
        "drupal/gin": "^3.0.0-alpha33",
        "drupal/gin_lb": "1.0.0-beta3",
        "drupal/gin_toolbar": "1.0-beta14",
        "drupal/google_tag": "1.x-dev@dev",
        "drupal/honeypot": "^2.0",
        "drupal/html_titles": "1.x-dev",
        "drupal/image_widget_crop": "^2.3",
        "drupal/inline_entity_form": "1.0-rc8",
        "drupal/interval": "^1.7",
        "drupal/jsonapi_hypermedia": "^1.6",
        "drupal/lazy": "^3.6",
        "drupal/link_attributes": "^1.11",
        "drupal/login_popup": "^2.0",
        "drupal/mailsystem": "^4.3",
        "drupal/markup": "^1.0@beta",
        "drupal/menu_item_extras": "^2.14",
        "drupal/mimemail": "^1.0@alpha",
        "drupal/nopremium": "^1.0",
        "drupal/other_view_filter": "1.x-dev@dev",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/pathologic": "^1.0@alpha",
        "drupal/paypal_subscriptions": "1.x-dev@dev",
        "drupal/phone_international": "^3.1",
        "drupal/react_comments": "1.0-beta2",
        "drupal/recaptcha": "^3.0",
        "drupal/recaptcha_v3": "^1.4",
        "drupal/search_api": "^1.19",
        "drupal/search_api_solr": "^4.1",
        "drupal/search_api_sorts": "^1.0",
        "drupal/search_api_spellcheck": "3.0-beta1",
        "drupal/selection_sharer": "^1.4",
        "drupal/sendgrid_api": "^1.0@alpha",
        "drupal/shs": "1.0-alpha5",
        "drupal/simple_pass_reset": "^1.1",
        "drupal/simple_sitemap": "^3.10",
        "drupal/smtp": "^1.0",
        "drupal/stage_file_proxy": "^1.1",
        "drupal/swiftmailer": "^2.0",
        "drupal/term_csv_export_import": "3.0-alpha2",
        "drupal/twig_tweak": "^3.0",
        "drupal/twig_views": "^1.3",
        "drupal/user_registrationpassword": "^1.0@alpha",
        "drupal/video_embed_field": "^2.4",
        "drupal/views_add_button": "1.7",
        "drupal/views_ajax_history": "^1.5",
        "drupal/views_block_area": "1.0-beta3",
        "drupal/views_field_view": "1.0-beta3",
        "drupal/views_fieldsets": "3.x-dev@dev",
        "drupal/views_infinite_scroll": "^1.7",
        "drupal/webform": "^6.0",
        "drupal/webform_sendgrid": "^1.0@alpha",
        "drush/drush": "^10",
        "npm-asset/intl-tel-input": "^17.0",
        "oomphinc/composer-installers-extender": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/selection_sharer": {
                "Corregir la URL del compartidor de Facebook": "https://www.drupal.org/files/issues/2020-08-06/Fix-Facebook-sharer-URL-3163780-6.patch"
            },
            "drupal/core": {
                "Grouped exposed taxonomy term filters do not work": "https://www.drupal.org/files/issues/1810148-58.patch"
            },
            "drupal/search_api_spellcheck": {
                "Enlace funcional con ajax": "patch/DidYouMean.patch"
            },
            "drupal/user_registrationpassword": {
                "Clases para mensaje Bienvenida en pop up ": "patch/RegistrationController.patch"
            },
            "drupal/commerce": {
              "add variation price to the Product variation title widget": "https://www.drupal.org/files/issues/2020-09-22/2930046-13.patch",
              "Precio aparece al lado del label del atributo": "patch/ProductVariationAttributesWidget.patch",
              "Permitir que los tipos de pedidos no tengan carritos": "https://www.drupal.org/files/issues/2020-10-05/2810723-130.patch",
              "Elimino condición que cambia nombre del botón de add to cart":"patch/CheckoutModule.patch"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
