{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "xdamman/selection-sharer",
                "version": "1.2.2",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/xdamman/selection-sharer/archive/refs/heads/master.zip",
                    "type": "zip"
                }
            }
        },
        {
          "type": "composer",
          "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/account_modal": "^1.0@RC",
        "drupal/address": "^2.0",
        "drupal/addtoany": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/advagg": "^6.0@alpha",
        "drupal/advancedqueue": "^1.0@RC",
        "drupal/antibot": "^2.0",
        "drupal/autologout": "^1.4",
        "drupal/bartik": "^1.0",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/block_class": "^2.0",
        "drupal/blockgroup": "^2.0",
        "drupal/captcha": "^1.14",
        "drupal/change_pwd_page": "^2.0",
        "drupal/chosen": "^3.0",
        "drupal/ckeditor_images_gallery": "^1.6",
        "drupal/ckeditor_media_embed": "2.x-dev@dev",
        "drupal/ckeditor_oembed": "^1.3",
        "drupal/ckeditor_paste_filter": "^1.1",
        "drupal/color": "^1.0",
        "drupal/colorbutton": "^1.5",
        "drupal/commerce": "^2.38",
        "drupal/commerce_checkout_order_fields": "^1.2",
        "drupal/commerce_paypal": "^1.7",
        "drupal/config_filter": "^2.6",
        "drupal/config_ignore": "^3.2",
        "drupal/context": "^5.0@RC",
        "drupal/core-composer-scaffold": "^10.2",
        "drupal/core-project-message": "^10.2",
        "drupal/core-recommended": "^10.2",
        "drupal/crop": "^2.3",
        "drupal/ctools": "^3.14",
        "drupal/datalayer": "^2.0",
        "drupal/disable_user_1_edit": "^1.6",
        "drupal/ds": "^5.0@alpha",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/email_registration": "^1.4",
        "drupal/entity": "^1.4",
        "drupal/entity_embed": "^1.5",
        "drupal/entity_reference_revisions": "^1.11",
        "drupal/facets": "^3.0@beta",
        "drupal/field_formatter_class": "^1.6",
        "drupal/field_group": "^3.4",
        "drupal/fixed_block_content": "^1.3",
        "drupal/flood_control": "^2.3",
        "drupal/gamw": "^1.1",
        "drupal/gin": "^3.0@RC",
        "drupal/gin_toolbar": "^1.0@RC",
        "drupal/google_analytics": "^4.0",
        "drupal/google_analytics_counter": "^4.0",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.1",
        "drupal/image_widget_crop": "^2.4",
        "drupal/imce": "^3.0",
        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/interval": "^1.12",
        "drupal/jquery_ui": "^1.6",
        "drupal/jquery_ui_datepicker": "^2.0",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/jsonapi_hypermedia": "^1.9",
        "drupal/key": "^1.17",
        "drupal/lazy": "^3.12",
        "drupal/link_attributes": "^2.1",
        "drupal/login_popup": "^2.1",
        "drupal/mailsystem": "^4.4",
        "drupal/markup": "^2.0@beta",
        "drupal/maxlength": "^2.1",
        "drupal/menu_item_extras": "^3.0",
        "drupal/metatag": "^2.0",
        "drupal/mimemail": "^1.0@alpha",
        "drupal/minifyhtml": "^2.0",
        "drupal/mobile_detect": "^3.0",
        "drupal/nopremium": "^1.1",
        "drupal/other_view_filter": "^1.3",
        "drupal/panelbutton": "^1.5",
        "drupal/paragraphs": "^1.17",
        "drupal/pathauto": "^1.12",
        "drupal/paypal_subscriptions": "^2.0",
        "drupal/phone_international": "^3.3",
        "drupal/prlp": "^1.10",
        "drupal/publishcontent": "^1.6",
        "drupal/purge": "^3.5",
        "drupal/quickedit": "^1.0",
        "drupal/rdf": "^2.1",
        "drupal/recaptcha": "^3.2",
        "drupal/recaptcha_v3": "^2.0",
        "drupal/redirect": "^1.9",
        "drupal/redis": "^1.7",
        "drupal/remove_http_headers": "^2.0",
        "drupal/scheduler": "^2.0",
        "drupal/schema_metatag": "^3.0",
        "drupal/search_api": "^1.27",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_sorts": "^1.1",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/seckit": "^2.0",
        "drupal/seven": "^1.0",
        "drupal/shs": "^2.0@RC",
        "drupal/simple_block": "^1.5",
        "drupal/simple_sitemap": "^4.1",
        "drupal/slick": "^3.0",
        "drupal/slick_extras": "^2.0",
        "drupal/slick_views": "^3.0",
        "drupal/smtp": "^1.2",
        "drupal/stage_file_proxy": "^2.1",
        "drupal/state_machine": "^1.10",
        "drupal/stop_spam_regs": "^2.0@beta",
        "drupal/svg_image": "^3.0",
        "drupal/term_csv_export_import": "^4.0",
        "drupal/text_summary_options": "^2.0",
        "drupal/textfield_counter": "^2.3",
        "drupal/theme_switcher": "^2.0",
        "drupal/tiny_html_audio_player": "^1.0",
        "drupal/token": "^1.13",
        "drupal/twig_tweak": "^3.2",
        "drupal/twig_views": "^2.0",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/upgrade_status": "^4.0",
        "drupal/user_registrationpassword": "^2.0",
        "drupal/username_enumeration_prevention": "^1.3",
        "drupal/video_embed_field": "^2.5",
        "drupal/views_add_button": "^2.0",
        "drupal/views_ajax_history": "^1.7",
        "drupal/views_block_area": "^1.0@beta",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_fieldsets": "^4.0",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_row_insert": "^2.1",
        "drupal/warmer": "^2.0",
        "drupal/webform": "^6.2",
        "drupal/webform_sendgrid": "^2.0@alpha",
        "drupal/webp": "^1.0@RC",
        "drush/drush": "^12",
        "mglaman/composer-drupal-lenient": "^1.0",
        "npm-asset/intl-tel-input": "^17.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "wikimedia/composer-merge-plugin": true,
            "drupal/console-extend-plugin": true,
            "oomphinc/composer-installers-extender": true,
            "mglaman/composer-drupal-lenient": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/selection_sharer": {
                "Corregir la URL del compartidor de Facebook": "https://www.drupal.org/files/issues/2020-08-06/Fix-Facebook-sharer-URL-3163780-6.patch"
            },
            "drupal/commerce": {
              "add variation price to the Product variation title widget": "https://www.drupal.org/files/issues/2020-09-22/2930046-13.patch",
              "Precio aparece al lado del label del atributo": "patch/ProductVariationAttributesWidget.patch",
              "Permitir que los tipos de pedidos no tengan carritos": "https://www.drupal.org/files/issues/2023-12-05/2810723-178.patch",
              "Cambio label de los pasos en el checkout": "patch/CommerceCheckoutProgressTwig.patch"
            },
            "drupal/change_pwd_page": {
                "Comento líneas en el route subscriber": "patch/RouteSubcriber.patch"
            },
            "drupal/prlp": {
                "Cambio título del formulario en el .module": "patch/PrlpModule.patch"
            },
            "drupal/username_enumeration_prevention": {
              "Cambio texto para cambio de contraseña": "patch/UsernameEnumerationPreventionModule.patch"
            },
            "drupal/search_api_spellcheck": {
                "Enlace funcional con ajax": "patch/DidYouMean.patch"
            },
            "drupal/gamw": {
                "Corrige atributos para error en contexto": "patch/Gamw.patch",
                "Fix Array Intersec": "patch/gamw-fix-intersec-array.patch",
                "D10": "https://www.drupal.org/files/issues/2022-06-15/gamw.1.x-dev.rector.patch"
            },
            "drupal/ckeditor_oembed": {
                "D10": "https://www.drupal.org/files/issues/2023-12-09/ckeditor_oembed.8.x-1.3.rector.patch"
            },
            "drupal/account_modal": {
                "D10": "https://www.drupal.org/files/issues/2023-12-09/account_modal.8.x-1.0-beta3.rector_0.patch"
            },
            "drupal/ckeditor_images_gallery": {
                "Automated Drupal 10 compatibility fixes": "https://www.drupal.org/files/issues/2023-12-09/ckeditor_images_gallery.8.x-1.6.rector.patch"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/gamw","drupal/ckeditor_oembed","drupal/ckeditor_images_gallery", "drupal/account_modal"]
        }
    },
    "require-dev": {
        "palantirnet/drupal-rector": "^0.19.2"
    }
}
