{#
/**
 * @file
 * Default theme implementation to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 *
 * @ingroup themeable
 */
#}


{% if title %}
	<h3>{{ title }}</h3>
{% endif %}
{% if device == 'desktop' %}
	{% set index_hide_lines = [4,5,8,9,12,13,14] %}

	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 6 %}
			<span class="block-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_16') }}</span>
		{% endif %}
		{% if loop.index  == 11 %}
			<span class="block-scroll block2 ads">{{ drupal_entity('block', 'gamwadvertisement_21') }}</span>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 8 %}
			<span class="wrapper">
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_10') }}</span>
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_59') }}</span>
			</span>
		{% endif %}
		
		{% if loop.index in index_hide_lines %}
			<div class="views-row not-show-line">
				{{- row.content -}}
			</div>
		{% else %}
			<div{{row.attributes.addClass(row_classes)}}>
				{{- row.content -}}
			</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 5 %}
			<span class="banner-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_15') }}</span>
		{% endif %}
		{% if loop.index == 9 %}
			<span class="banner-scroll ban2 ads">{{ drupal_entity('block', 'gamwadvertisement_18') }}</span>
		{% endif %}
		{% if loop.index == 14 %}
			<span class="banner-scroll ban3 ads">{{ drupal_entity('block', 'gamwadvertisement_19') }}</span>
		{% endif %}

	{% endfor %}
{% endif %}

{% if device == 'mobile' %}

	{% set index_hide_lines = [5,9,14] %}

	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 6 %}
			<span class="block-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_16') }}</span>
		{% endif %}

		{## banner ##}
		{% if loop.index == 6 %}
			<span class="banner-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_15') }}</span>
		{% endif %}
		
		{% if loop.index in index_hide_lines %}
			<div class="card-one-column views-row not-show-line-mobile">
				{{- row.content -}}
			</div>
		{% else %}
			<div{{row.attributes.addClass(row_classes)}}>
				{{- row.content -}}
			</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 9 %}
			<span class="banner-scroll ban2 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_18') }}</span>
		{% endif %}
		{% if loop.index == 14 %}
			<span class="banner-scroll ban3 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_19') }}</span>
		{% endif %}
	{% endfor %}
{% endif %}
