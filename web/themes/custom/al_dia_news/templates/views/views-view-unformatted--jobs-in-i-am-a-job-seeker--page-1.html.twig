{#
/**
 * @file
 * Default theme implementation to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 *
 * @ingroup themeable
 */
#}
{% if title %}
	<h3>{{ title }}</h3>
{% endif %}
{% if rows.device[0] == 'desktop' %}
	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 6 %}
			<div class="block-scroll">{{ drupal_entity('block', 'gamwadvertisement_16') }}</div>
		{% endif %}
		{% if loop.index  == 11 %}
			<div class="block-scroll">{{ drupal_entity('block', 'gamwadvertisement_16') }}</div>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 8 %}
			<div class="skys-scroll">{{ drupal_entity('block', 'gamwadvertisement_17') }}</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 6 %}
			<div class="banner-scroll">{{ drupal_entity('block', 'gamwadvertisement_15') }}</div>
		{% endif %}
		{% if loop.index == 9 %}
			<div class="banner-scroll ban2">{{ drupal_entity('block', 'gamwadvertisement_18') }}</div>
		{% endif %}
		{% if loop.index == 14 %}
			<div class="banner-scroll ban3">{{ drupal_entity('block', 'gamwadvertisement_19') }}</div>
		{% endif %}

		<div{{row.attributes.addClass(row_classes)}}>
			{{- row.content -}}
		</div>
	{% endfor %}
{% endif %}

{% if rows.device[0] == 'mobile' %}
	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 6 %}
			<div class="block-scroll">{{ drupal_entity('block', 'gamwadvertisement_16') }}</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 7 %}
			<div class="banner-scroll">{{ drupal_entity('block', 'gamwadvertisement_15') }}</div>
		{% endif %}
		{% if loop.index == 11 %}
			<div class="banner-scroll ban2">{{ drupal_entity('block', 'gamwadvertisement_18') }}</div>
		{% endif %}
		{% if loop.index == 16 %}
			<div class="banner-scroll ban3">{{ drupal_entity('block', 'gamwadvertisement_19') }}</div>
		{% endif %}
		<div{{row.attributes.addClass(row_classes)}}>
			{{- row.content -}}
		</div>
	{% endfor %}
{% endif %}
