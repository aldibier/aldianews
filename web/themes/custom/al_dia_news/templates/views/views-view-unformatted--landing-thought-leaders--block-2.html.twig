{#
/**
 * @file
 * Default theme implementation to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 *
 * @ingroup themeable
 */
#}


{% if title %}
	<h3>{{ title }}</h3>
{% endif %}

{% if device == 'desktop' %}

	{% set index_hide_lines = [7,8,9,15,16,17,23,24,29,30,31] %}

	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 15 %}
			<span class="block-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_16') }}</span>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 22 %}
			<span class="wrapper-ads">
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_10') }}</span>
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_59') }}</span>
			</span>
		{% endif %}
		{% if loop.index  == 24 %}
			<span class="wrapper-ads two">
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_60') }}</span>
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_61') }}</span>
			</span>
		{% endif %}

		{% if loop.index in index_hide_lines %}
			<div class="views-row not-show-line">
				{{- row.content -}}
			</div>
		{% else %}
			<div{{row.attributes.addClass(row_classes)}}>
				{{- row.content -}}
			</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 9 %}
			<span class="banner-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_15') }}</span>
		{% endif %}
		{% if loop.index == 17 %}
			<span class="banner-scroll ban2 ads">{{ drupal_entity('block', 'gamwadvertisement_18') }}</span>
		{% endif %}
		{% if loop.index == 23 %}
			<span class="banner-scroll ban3 ads">{{ drupal_entity('block', 'gamwadvertisement_19') }}</span>
		{% endif %}
		{% if loop.index == 31 %}
			<span class="banner-scroll last-banner ads">{{ drupal_entity('block', 'gamwadvertisement_36') }}</span>
		{% endif %}
	{% endfor %}
{% endif %}

{% if device == 'mobile' %}

	{% set index_hide_lines = [5,6,11,12,15,16] %}

	{% for row in rows %}

		{%
			set row_classes = [
			default_row_class ? 'views-row',
			]
		%}

		{## block ##}
		{% if loop.index  == 7 %}
			<span class="block-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_16') }}</span>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 17 %}
			<span class="wrapper-ads">
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_10') }}</span>
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_59') }}</span>
			</span>
		{% endif %}
		{% if loop.index  == 19 %}
			<span class="wrapper-ads two">
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_60') }}</span>
				<span class="ads">{{ drupal_entity('block', 'gamwadvertisement_61') }}</span>
			</span>
		{% endif %}

		{% if loop.index in index_hide_lines %}
			<div class="views-row not-show-line-mobile">
				{{- row.content -}}
			</div>
		{% else %}
			<div{{row.attributes.addClass(row_classes)}}>
				{{- row.content -}}
			</div>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 11 %}
			<span class="skys-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_17') }}</span>
		{% endif %}

		{## block ##}
		{% if loop.index  == 11 %}
			<span class="block-scroll block2 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_21') }}</span>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 12 %}
			<span class="skys-scroll skys2 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_20') }}</span>
		{% endif %}

		{## banner ##}
		{% if loop.index == 16 %}
			<span class="banner-scroll last-banner ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_36') }}</span>
		{% endif %}
	{% endfor %}
{% endif %}
