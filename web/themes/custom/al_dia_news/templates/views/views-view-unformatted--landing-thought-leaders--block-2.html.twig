{#
/**
 * @file
 * Default theme implementation to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 *
 * @ingroup themeable
 */
#}
{% if title %}
	<h3>{{ title }}</h3>
{% endif %}
{% if device == 'desktop' %}

	{% set index_hide_lines = [7,8,9,15,16,17,23,24,29,30,31] %}

	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 15 %}
			<div class="block-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_16') }}</div>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 22 %}
			<div class="skys-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_17') }}</div>
		{% endif %}
		{% if loop.index  == 24 %}
			<div class="skys-scroll skys2 ads">{{ drupal_entity('block', 'gamwadvertisement_20') }}</div>
		{% endif %}

		{% if loop.index in index_hide_lines %}
			<div class="views-row not-show-line">
				{{- row.content -}}
			</div>
		{% else %}
			<div{{row.attributes.addClass(row_classes)}}>
				{{- row.content -}}
			</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 9 %}
			<div class="banner-scroll ads">{{ drupal_entity('block', 'gamwadvertisement_15') }}</div>
		{% endif %}
		{% if loop.index == 17 %}
			<div class="banner-scroll ban2 ads">{{ drupal_entity('block', 'gamwadvertisement_18') }}</div>
		{% endif %}
		{% if loop.index == 23 %}
			<div class="banner-scroll ban3 ads">{{ drupal_entity('block', 'gamwadvertisement_19') }}</div>
		{% endif %}
		{% if loop.index == 31 %}
			<div class="banner-scroll last-banner ads">{{ drupal_entity('block', 'gamwadvertisement_36') }}</div>
		{% endif %}

	{% endfor %}
{% endif %}

{% if device == 'mobile' %}
	{% for row in rows %}

		{%
		set row_classes = [
		default_row_class ? 'views-row',
		]
	%}

		{## block ##}
		{% if loop.index  == 10 %}
			<div class="block-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_16') }}</div>
		{% endif %}

		{## skyscraper ##}
		{% if loop.index  == 17 %}
			<div class="skys-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_17') }}</div>
		{% endif %}
		{% if loop.index  == 19 %}
			<div class="skys-scroll skys2 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_20') }}</div>
		{% endif %}

		{## banner ##}
		{% if loop.index == 6 %}
			<div class="banner-scroll ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_15') }}</div>
		{% endif %}
		{% if loop.index == 14 %}
			<div class="banner-scroll ban2 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_18') }}</div>
		{% endif %}
		{% if loop.index == 18 %}
			<div class="banner-scroll ban3 ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_19') }}</div>
		{% endif %}
		{% if loop.index == 24 %}
			<div class="banner-scroll last-banner ads ads-mobile">{{ drupal_entity('block', 'gamwadvertisement_36') }}</div>
		{% endif %}

		<div{{row.attributes.addClass(row_classes)}}>
			{{- row.content -}}
		</div>
	{% endfor %}
{% endif %}
