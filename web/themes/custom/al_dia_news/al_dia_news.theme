    $vars['device'] = 'desktop';
  }

  /// landing categoria

  if($id == 'last_news'){

		if($display->display['id'] === 'block_2'){
			static $index;

			if(empty($index)) $index = 0;

			switch($index){
        case 0:
          $vars['rows']['index_pos'][] = '1';
					$index = 1;
        break;
        case 1:
					$vars['rows']['index_pos'][] = '2';
          $index = 2;
        break;
        case 2:
					$vars['rows']['index_pos'][] = '3';;
          $index = 3;
        break;
      }

		}

    if($display->display['id'] === 'block_3'){
      static $control;

      if(empty($control)) $control = 0;

      switch($control){
        case 0:
          $vars['rows']['block_type'][] = 'block_top';
          $control = 1;
        break;
        case 1:
          $vars['rows']['block_type'][] = 'advertising_complete';
          $control = 2;
        break;
        case 2:
          $vars['rows']['block_type'][] = 'block_bottom';
          $control = 0;
        break;
      }
    }
