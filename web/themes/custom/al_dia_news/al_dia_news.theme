<?php
use Drupal\Core\Url;


/**
 * @file
 * Theme functions.
 */

 /**
 * Implements hook_preprocess_views_view()
 */
function al_dia_news_preprocess_views_view(&$vars) {
  if (isset($_GET['token']))
  {
    $vars['get_token'] = $_GET['token'];
  }
}

function al_dia_news_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id == 'comment_comments_content_form' ) {
    $form['actions']['preview'] = [
    '#type' => 'link',
    '#title' => t('Cancel'),
          '#attributes' => [
              'class' => [
              'cancel-modal',
              ],
          ],
    ];
  }
} 