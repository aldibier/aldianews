  if($id === 'block_guest'){
    $entityManager = \Drupal::service('entity_type.manager');

    /* $current_path = \Drupal::service('path.current')->getPath();
    $explodePath = explode('/',$current_path);
    $nodeId = $explodePath[2]; */
    $node = \Drupal::request()->attributes->get('node');
    $nodeId = $node->id();
    $entityNode = $entityManager->getStorage('node')->load($nodeId);
    $guestFields = $entityNode->field_guest_block;
    $styleValues = [];

    if(isset($guestFields)){
      foreach($guestFields as $guestField){
        $paragraphId = $guestField->getValue()['target_id'];
        $entityParagraph = $entityManager->getStorage('paragraph')->load($paragraphId);
        $styleValues[] = $entityParagraph->field_style->value;
      }
    }

    if(!empty($styleValues)){
      foreach($vars['rows'] as $index => $row){
        $vars['rows'][$index]['content']['style'] = $styleValues[$index];
      }
    }
