<?php
use Drupal\Core\Url;


/**
 * @file
 * Theme functions.
 */

function al_dia_news_preprocess_node(&$vars) {
}

 /**
 * Implements hook_preprocess_views_view()
 */
function al_dia_news_preprocess_views_view(&$vars) {
  if (isset($_GET['token']))
  {
    $vars['get_token'] = $_GET['token'];
  }
}

function is_mobile() {
  if (empty($_SERVER['HTTP_USER_AGENT'])) {
      $is_mobile = false;
  } else if (strpos($_SERVER['HTTP_USER_AGENT'], 'Mobile') !== false
      // many mobile devices (all iPhone, iPad, etc.)
      || strpos($_SERVER['HTTP_USER_AGENT'], 'Android') !== false
      || strpos($_SERVER['HTTP_USER_AGENT'], 'Silk/') !== false
      || strpos($_SERVER['HTTP_USER_AGENT'], 'Kindle') !== false
      || strpos($_SERVER['HTTP_USER_AGENT'], 'BlackBerry') !== false
      || strpos($_SERVER['HTTP_USER_AGENT'], 'Opera Mini') !== false
      || strpos($_SERVER['HTTP_USER_AGENT'], 'Opera Mobi') !== false) {
      $is_mobile = true;
  } else {
      $is_mobile = false;
  }
  return $is_mobile;
}

function al_dia_news_preprocess_views_view_unformatted(&$vars) {

  if (is_mobile()) {
    $vars['rows']['is_mobile'][] =  'Is a mobile device';
  } else {
    $vars['rows']['is_mobile'][] =  'Not a mobile device.';
  }
}


