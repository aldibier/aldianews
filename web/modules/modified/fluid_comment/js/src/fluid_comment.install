<?php

/**
 * @file
 * Module install file.
 */

use Drupal\Core\Url;

/**
 * Implements hook_requirements().
 */
function fluid_comment_requirements($phase) {
  $requirements = [];
  if ($phase === 'runtime' || $phase === 'install') {

    $jsonapi_read_only = \Drupal::config('jsonapi.settings')->get('read_only');
    $jsonapi_settings_title = t('Accept all JSON:API create, read, update, and delete operations.');

    if ($jsonapi_read_only) {
      $requirements['fluid_comment_jsonapi_write'] = [
        'title' => t('Fluid Comment status'),
        'value' => t('Configuration change required'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('Fluid Comment requires JSON:API to be configured to <a href=":jsonapi-settings">@jsonapi-settings-title</a>', [
          ':jsonapi-settings' => Url::fromRoute('jsonapi.settings')->toString(),
          '@jsonapi-settings-title' => $jsonapi_settings_title,
        ]),
      ];
    }
  }

  return $requirements;
}
