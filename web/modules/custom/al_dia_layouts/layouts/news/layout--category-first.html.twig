{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div class="container-content">

    {% if content.one_content %}
        <div {{ region_attributes.one_content.addClass('one-content-category') }}>
          {{ content.one_content|without("title") }} 
        </div>
    {% endif %}

    {% if content.two_content %}
        <div {{ region_attributes.two_content.addClass('two-content-category news-category-container main-news-content') }}>
          {{ content.two_content}} 
        </div>
    {% endif %}

  </div>
{% endif %}
