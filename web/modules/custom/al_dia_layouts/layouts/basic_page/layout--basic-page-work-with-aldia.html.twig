{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
	<div class="container-content">
		{% if content.block_image %}
			<div {{ region_attributes.block_image.addClass('block-image-basic-page-work block-hero-image') }}>
				{{ content.block_image }}
			</div>
		{% endif %}
		{% if content.menu %}
			<div {{ region_attributes.menu.addClass('menu-basic-page-work') }}>
				{{ content.menu }}
			</div>
		{% endif %}
			{% if content.horizontal_advertising %}
				<div {{ region_attributes.horizontal_advertising.addClass('horizontal-advertising-general-horizontal banner-horizontal') }}>
					{{ content.horizontal_advertising }}
				</div>
			{% endif %}
		<div class="content-page-node">
			{% if content.two_content %}
				<div {{ region_attributes.two_content.addClass('two-content-general-work') }}>
					{{ content.two_content }}
				</div>
			{% endif %}
			{% if content.one_vertical_advertising %}
				<div {{ region_attributes.one_vertical_advertising.addClass('one-vertical-advertising') }}>
					{{ content.one_vertical_advertising }}
				</div>
			{% endif %}
			{% if content.two_vertical_advertising %}
				<div {{ region_attributes.two_vertical_advertising.addClass('two-vertical-advertising') }}>
					{{ content.two_vertical_advertising }}
				</div>
			{% endif %}
		</div>

	</div>
{% endif %}
