{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
	<div class="container-content width1440">

		{% if content.header_content %}
			<div {{ region_attributes.header_content.addClass('header-content banner-events') }}>
				{{ content.header_content }}
				{% if content.content_header %}
					<div {{ region_attributes.content_header.addClass('header-content-date-place') }}>
						{{ content.content_header }}
					</div>
				{% endif %}
				<div class="text-and-buttons-event section-flex">
					<span>{{ 'Click here to register, to nominate, or to sponsor.'|trans }}</span>
					<button name="nominee" type="button">{{ 'NOMINATE'|trans }}</button>
					<button name="register-here" type="button">{{ 'REGISTER HERE'|trans }}</button>
					<button name="sponsorship" type="button">{{ 'SPONSORSHIP'|trans }}</button>
				</div>
			</div>
		{% endif %}

		{% if content.advertising_content %}
			<div {{ region_attributes.advertising_content.addClass('body-adversiting-section') }}>
				{{ content.advertising_content }}
			</div>
		{% endif %}

		<div {{ region_attributes.two_content.addClass('container-right-event') }}>
			<div class="section-event-body section-flex section1310">
				{% if content.one_first %}
					<div {{ region_attributes.one_first.addClass('body-lateral-section') }}>
						{{ content.one_first }}
					</div>

				{% endif %}
				{% if content.one_second %}
					<div {{ region_attributes.one_second.addClass('body-lateral-section-advertising') }}>
						{{ content.one_second }}
					</div>
				{% endif %}
			</div>
		</div>
		<div class="content-present-by-advertising  section1310">
			{% if content.three_content %}
				<div {{ region_attributes.three_content.addClass('three-content-event body-lateral-section') }}>
					{{ content.three_content }}
				</div>
			{% endif %}
			{% if content.three_content_second %}
				<div {{ region_attributes.three_content_second.addClass('three-content-event-advertising body-lateral-section-advertising') }}>
					{{ content.three_content_second }}
				</div>
			{% endif %}
		</div>
		<div class="guest-event-advertising section1310">
			{% if content.four_content %}
				<div {{ region_attributes.four_content.addClass('four-content-event') }}>
					{{ content.four_content }}
				</div>
			{% endif %}

		</div>
		{% if content.five_content %}
			<div {{ region_attributes.five_content.addClass('five-content-event-sliders section1310') }}>
				{{ content.five_content }}
			</div>
		{% endif %}
		{% if content.six_content %}
			<div {{ region_attributes.six_content.addClass('five-content-event-contact section1310') }}>
				{{ content.six_content }}
			</div>
		{% endif %}
	</div>
{% endif %}
