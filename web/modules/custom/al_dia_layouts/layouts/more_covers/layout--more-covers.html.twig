{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div class="container-content">
      <div class="content-left-pages">
        {% if content.one_content %}
            <div {{ region_attributes.one_content.addClass('one-content-covers') }}>
              {{ content.one_content }} 
            </div>
        {% endif %}

        {% if content.three_content %}
        <div {{ region_attributes.three_content.addClass('related-content-covers') }}>
          {{ content.three_content }} 
        </div>
        {% endif %}
      </div>

      <div class="content-right-pages">
        {% if content.two_content %}
          <div {{ region_attributes.two_content.addClass('advertising-covers') }}>
            {{ content.two_content }} 
          </div>
        {% endif %}
      </div>
  </div>
{% endif %}