{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div class="container-content">

    {% if content.horizontal_advertising %}
        <div {{ region_attributes.horizontal_advertising.addClass('horizontal-advertising-general-horizontal') }}>
          {{ content.horizontal_advertising }} 
        </div>
    {% endif %}
    <div class="content-left-pages">
      {% if content.one_content_employer_information %}
          <div {{ region_attributes.one_content_employer_information.addClass('one-content-employer-information') }}>
            {{ content.one_content_employer_information }} 
          </div>
      {% endif %}
      <div class="business">
        {% if content.employer_information_image %}
            <div {{ region_attributes.employer_information_image.addClass('employer-information-image') }}>
              {{ content.employer_information_image }} 
            </div>
        {% endif %}
        {% if content.employer_information_information %}
            <div {{ region_attributes.employer_information_information.addClass('employer-information-information') }}>
              {{ content.employer_information_information }} 
            </div>
        {% endif %}
      </div>
      {% if content.two_content_body %}
          <div {{ region_attributes.two_content_body.addClass('two-content-body-job') }}>
            {{ content.two_content_body }} 
          </div>
      {% endif %}
      {% if content.three_content_jobs %}
          <div {{ region_attributes.three_content_jobs.addClass('three-content-jobs') }}>
            {{ content.three_content_jobs }} 
          </div>
      {% endif %}
    </div>
    <div class="content-right-pages">
      <div class="pautas">
        {% if content.one_vertical_advertising %}
            <div {{ region_attributes.one_vertical_advertising.addClass('one-vertical-advertising') }}>
              {{ content.one_vertical_advertising }} 
            </div>
        {% endif %}
        {% if content.two_vertical_advertising %}
            <div {{ region_attributes.two_vertical_advertising.addClass('two-vertical-advertising') }}>
              {{ content.two_vertical_advertising }} 
            </div>
        {% endif %}
      </div>
    </div>

  </div>
{% endif %}

{# Se obtiene la fecha actual #}
{% set now = date() %}

{# Mediante un condicional  se compara la fecha de expiracion con la fecha actual, ambas fechas se pasan se segundos en Unix y a la fecha actual se le suman 604800 segundos que corresponden a las 7 dias de diferencia horaria #}

{% if ((field_expiration_date__value | date('U') )) <= ((now | date('U')) + 604800) %}
<div class="container-content__date lightned">

  {% if ((now | date('U'))  > (field_expiration_date__value | date('U'))) %}
    <p>{{ now | date("d") - field_expiration_date__value | date("d") }} DAYS LEFT TO APPLY </p>
  {% else %}
    <p>{{ field_expiration_date__value | date("d")  -  now | date("d") }} DAYS LEFT TO APPLY </p>
  {% endif %}

</div>
{% else %}
<div class="container-content__date">
    {% if (now | date('d'))  > (field_expiration_date__value | date('d') ) %}
    <p>{{ now | date('U') - field_expiration_date__value | date('U') }} DAYS LEFT TO APPLY </p>
  {% else %}
    <p>{{ field_expiration_date__value | date('U')  -  now | date('U') }} DAYS LEFT TO APPLY </p>
  {% endif %}
</div>
{% endif %}