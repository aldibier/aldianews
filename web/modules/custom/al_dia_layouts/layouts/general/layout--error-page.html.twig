{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div class="container-content">

    {% if content.one_content %}
        <div {{ region_attributes.one_content.addClass('one-content-general') }}>
          {{ content.one_content }} 
        </div>
    {% endif %}
      {% if content.advertising %}
        <div {{ region_attributes.advertising.addClass('advertising-general-horizontal') }}>
          {{ content.advertising }} 
        </div>
    {% endif %}
      {% if content.two_content %}
        <div {{ region_attributes.two_content.addClass('two_content-general') }}>
          {{ content.two_content }} 
        </div>
    {% endif %}

  </div>
{% endif %}