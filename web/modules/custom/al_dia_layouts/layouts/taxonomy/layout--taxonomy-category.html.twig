{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div class="container-content">

    {% if content.one_content_right %}
        <div {{ region_attributes.one_content_right.addClass('content-rigth-category') }}>
          {{ content.one_content_right }} 
        </div>
    {% endif %}
    {% if content.one_content %}
        <div {{ region_attributes.one_content.addClass('one-content-taxonomy-category') }}>
          {{ content.one_content }} 
        </div>
    {% endif %}
    {% if content.two_more_content %}
        <div {{ region_attributes.two_more_content.addClass('two-more-content-taxonomy-category') }}>
          {{ content.two_more_content}} 
        </div>
    {% endif %}
    {% if content.subcategory %}
        <div {{ region_attributes.subcategory.addClass('subcategory-taxonomy') }}>
          {{ content.subcategory}} 
        </div>
    {% endif %}

  </div>
{% endif %}