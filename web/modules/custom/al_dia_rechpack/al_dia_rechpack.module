<?php
/**
 * Implements hoock_theme().
 */
function al_dia_rechpack_theme($existing, $type, $theme, $path) {

    return [
      'active_subscruption_mail' => [
        'variables' => [
          'url' => NULL,
        ],
      ],
      'return_paypal_active_mail' => [
        'variables' => [
          'email' => NULL,
        ],
      ],
      'active_subscruption_mail_no_services' => [
        'variables' => [
          'url' => NULL,
        ],
      ],
    ];
}

/**
 * Implements hook_mail().
 */
function al_dia_rechpack_mail($key, &$message, $params){
    $options = [
      'langcode' => $message['langcode'],
    ];
    switch ($key) {
      case 'active_subscription':
        $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
        $message['from'] = [\Drupal::config('system.site')->get('mail')];
        $message['subject'] = t('@title', ['@title' => $params['title']], $options);
        $message['body'][] = $params['message'];
      break;
      case 'return_paypal_active':
        $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
        $message['from'] = [\Drupal::config('system.site')->get('mail')];
        $message['subject'] = t('@title', ['@title' => $params['title']], $options);
        $message['body'][] = $params['message'];
      break;
      case 'active_subscription_no_services':
        $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
        $message['from'] = [\Drupal::config('system.site')->get('mail')];
        $message['subject'] = t('@title', ['@title' => $params['title']], $options);
        $message['body'][] = $params['message'];
      break;
  }

}
  