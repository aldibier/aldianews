<?php

use Drupal\Core\Messenger\MessengerInterface;

/**
 * @file
 * Contains al_dia_preroll.module.
 */

function al_dia_preroll_preprocess_node(&$vars) {
  $config = \Drupal::config('al_dia_preroll.adminsettings');
  $campaigns = $config->get('campaigns');
  $randomOrder = $config->get('random_order');
  $browserStorage = $config->get('browser_storage');

  if (count($campaigns) > 0) {
    $arr = [];
    $i = 0;
    foreach ($campaigns as $campaign) {
      if (!$campaign['turn_off_campaign']) {
        $arr[$i]['randomOrder'] = $campaign["random_order"];
        $arr[$i]['posCampaign'] = $campaign["pos_campaign"];
        if (!empty($campaign["middle_video"]) && $campaign["middle_video"] != "") {
          $arr[$i]['middleVideo'] = $campaign["middle_video"];
        }
        if (isset($campaign['vast']) && count($campaign['vast']) > 0) {
          $arr[$i]['vast'] = $campaign["vast"];
        }
        $i++;
      }
    }

    if ($randomOrder) {
      $arr = customShuffle($arr);
    }
    else {
      usort($arr, function ($a, $b) {
        return $a['posCampaign'] - $b['posCampaign'];
      });
    }
    $arr = sortCampaignsAndVasts($arr);
    $arr['browser_storage'] = $browserStorage;
    $vars['#attached']['drupalSettings']['campaigns'] = $arr;
  }
}

function sortCampaignsAndVasts($array): array {
  return array_map(function ($element) {
    if ($element['randomOrder']) {
      $element['vast'] = customShuffle($element['vast']);
    }
    else {
      usort($element['vast'], function ($a, $b) {
        return $b['pos_vast'] - $a['pos_vast'];
      });
    }
    return $element;
  }, $array);
}

function customShuffle($a): array {
  for ($i = count($a) - 1; $i > 0; $i--) {
    $j = rand(0, $i);
    [$a[$i], $a[$j]] = [$a[$j], $a[$i]];
  }
  return $a;
}


