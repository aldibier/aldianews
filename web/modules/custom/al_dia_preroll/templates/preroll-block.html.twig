{# Reproductor SDK #}
<div id="video-container" class="muted">
	<video id="video-element" playsinline muted></video>
	<div id="ad-container"></div>
	<div id="ads-main-controls">
		<button id="play-previous" class="disabled" disabled>Previous</button>
		<button id="play-switch">Play</button>
		<button id="play-next">Next</button>
	</div>
	<div id="ads-secundary-controls">
		<div id="ads-progress-container">
			<div id="ads-progress">
				<span class="bar"></span>
			</div>
		</div>
		<div id="ads-sound-container">
			<button id="ads-sound">Unmuted</button>
		</div>
		<div id="ads-time-container">
			<span class="ads-time-left">00:00</span> / <span class="ads-time-total">00:00</span>
		</div>
		<div id="ads-fullscreen-container">
			<button id="ads-fullscreen">Fullscreen</button>
		</div>
	</div>
	<a class="ads-destiny-link" target="_blank">Ads destiny link</a>
	<button id="btn-close-preroll">Close ads video</button>
	<button id="play-button" style="display:none">Play</button>
</div>
