/**
 * @file
 * Contains al_dia_news_general.module.
 */

function al_dia_news_general_page_attachments(&$variables) {
  $variables['#attached']['library'][] = 'al_dia_news_general/custom_css';
}

/**
 * Implements hook_help().
 */
function al_dia_news_general_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the al_dia_news_general module.
    case 'help.page.al_dia_news_general':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Al día news general') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_form_alter()
 */
function al_dia_news_general_form_alter(&$form, $form_state, $form_id) {
  //Saber el path
  // $current_path = \Drupal::service('path.current')->getPath();
  // $url_object = \Drupal::service('path.validator')->getUrlIfValid($current_path);
  // ksm($url_object);
  // $route_name = $url_object->getRouteName();
  // ksm($route_name);
  // $route_parameters = $url_object->getrouteParameters();
  switch ($form_id) {
    case  "comment_comments_content_form":
    // Alteración del botón submit de comentarios.
      $form['actions']['submit']['#value'] = t('POST COMMENT');
      $myUrl = "My";
      $form['actions']['submit_cancel'] = [
        // '#type' => 'submit',
        // '#value' => t('BACK'),
        // '#weight' => 99,
        // '#limit_validation_errors' => [],
        //'#markup' => '<div class="cbutton-back">BACK</div>',
      ];
      $form['#title'] = t("EDIT COMMENT");
      $form['field_comment_body']['widget'][0]['value']['#title_display'] = "hidden";

      // $form['actions']['submit_cancel']['#attributes']['class'][] = 'cbutton-back';
    break;
    case "node_news_edit_form":
      $form['field_podcast_player']['widget'][0]['#format'] = "podcast";
    break;
    case "node_news_form":
      $form['field_podcast_player']['widget'][0]['#format'] = "podcast";
    break;
    case "comment_comments_content_delete_form":
      $form['#title'] = t("ARE YOU SURE YOU WANT TO DELETE THE COMMENT?");
    break;

  }


}


function al_dia_news_form_views_exposed_form_alter(&$form, &$form_state) {
  if($form["#id"] == 'views-exposed-form-more-videos-in-landing-block-1') {
    $form['tid']['#options']['All'] = 'Any';
  };
  if($form["#id"] == 'views-exposed-form-search-results-al-dia-solr-page-1') {
    $form['field_category']['#options']['All'] = 'Select';
    $form['field_my_content_has_a_main_vide']['#options']['All'] = 'Select';
    $form['sort_bef_combine']['#options']['created_ASC'] = 'OLDEST';
    $form['sort_bef_combine']['#options']['created_DESC'] = 'NEWEST';
    $form['sort_bef_combine']['#options']['search_api_relevance_DESC'] = 'RELEVANCE';
  };
  if($form["#id"] == 'views-exposed-form-more-covers-landing-page-1') {
    $form['field_year_value']['#options']['All'] = 'All';
  }
}


/**
 * Implement hook_views_query_alter.
 *
 * Se usa para alterar la consulta sql de la vista.
 *
 * @param view propiedades de la vista
 * @param query consulta sql de la vista
 */
function al_dia_news_general_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  switch ($view->id()) {
    case 'last_news':
      if ($view->getDisplay()->display['id'] == 'block_1') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_2') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_3') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_4') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->range(0, 5);
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $results = $query1->execute()->fetchCol();
          if($results){
            $query2 = $database->select('taxonomy_term__parent', 'ttp');
            $query2->addField("ttp", "entity_id");
            $query2->condition("ttp.parent_target_id", $path_args[3], "=");
            $hijos = $query2->execute();
            $nids = $results;
            foreach ($hijos as $hijo){
              $query1 = $database->select('node_field_data', 'nfd');
              $query1->addField("nfd", "nid");
              $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
              $query1->innerJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
              $query1->condition("tfd.tid", $hijo->entity_id, "=");
              $query1->condition("nfd.type", "news", "=");
              $query1->condition("nfd.status", 1, "=");
              $query1->condition("nfd.nid", $nids, "NOT IN");
              $query1->distinct();
              $query1->orderBy("nfd.created", "DESC");
              $query1->range(0, 9);
              $results = $query1->execute()->fetchCol();
              if ($results){
                $nids = array_merge( $nids, $results);
              }
            }
            if($nids){
              foreach ($query->where as &$condition_group) {
                foreach ($condition_group['conditions'] as &$condition) {
                  if($condition["field"] == "node_field_data.nid"){
                    $condition["value"] = $nids;
                    $condition["operator"] = "NOT IN";
                  }
                }
              }
            }
          }
        }
      }
    break;
    //Omito el id de los nodos del primer bloque en el home
    //Este id esta almacenado en una variable de caché nids_home en el archivo src/block/LatestCategories
    case "leadership_sons":
      if ($view->getDisplay()->display['id'] == 'block_1') {
        $cache = \Drupal::service('tempstore.private')->get('al_dia_news');
        $cached = $cache->get("nids_home");
        if ($cached) {
          foreach ($query->where as &$condition_group) {
            foreach ($condition_group['conditions'] as &$condition) {
              if($condition["field"] == "node_field_data.nid"){
                $condition["value"] = $cached;
                $condition["operator"] = "NOT IN";
                //ksm($cached->data);
              }
            }
