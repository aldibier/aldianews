        '#type' => 'link',
        '#title' => t('GO BACK'),
        '#weight' => 100000,
        '#url' => Url::fromUri('route:<nolink>'),
        '#attributes' => [
          'class' => [
            'user-login',
          ],
        ],
      ];
    break;
    case "user_pass_reset":
      $form['message']['#markup'] = t('<p>Hello,</p><p>Please remember that this is a one-time link to set a new password and log in and it will expire in the next 24 hours. If you don’t have access to this link later, request a new one by entering to the “Forgot your password?” in the log in section.</p>');
      $form['help']['#markup'] = "";
      $form['actions']['submit']['#value'] = t('CHANGE PASSWORD AND LOG IN');
      $form['actions']['submit']['#submit'][] = 'custom_cancel_account';

    break;
    case "user_form":
      $form['#title'] = t("EDIT");
      if ( $current_user->getRoles()[1] != "administrator") {
        $form['actions']['delete']['#access'] = FALSE;
        $form['actions']['cancel'] = [
          '#type' => 'link',
          '#title' => t('BACK'),
          '#url' => Url::fromRoute('al_dia_news_general.modal', [
            'type' => 'user',
          ]),
          '#attributes' => [
            'class' => [
              'use-ajax',
              'user-register-login',
            ],
            'data-dialog-type' => 'modal',
            'data-dialog-options' => Json::encode(['dialogClass' => 'popup-login'],['width' => 550]),
          ],
        ];
        $form['actions']['submit']['#submit'][] = 'custom_cancel_account';

      }

    break;
    case "user_cancel_form":
      $form['actions']['submit']['#submit'][] = 'custom_cancel_account';
      if ( $current_user->getRoles()[1] != "administrator") {
        $form['actions']['cancel'] = [
          '#type' => 'link',
          '#title' => t('CANCEL'),
          '#url' => Url::fromRoute('al_dia_news_general.modal', [
            'type' => 'user',
          ]),
          '#attributes' => [
            'class' => [
              'use-ajax',
              'user-register-login',
            ],
            'data-dialog-type' => 'modal',
            'data-dialog-options' => Json::encode(['dialogClass' => 'popup-login'],['width' => 550]),
          ],
        ];
        $form['#title'] = t('CANCEL MY ACCOUNT');
      }
    break;
  }
  if (strpos($form_id, 'commerce_order_item_add_to_cart_form_commerce_product_') !== FALSE) {
    $product = $form_state->get('product');
    switch ($product->bundle()) {
      case 'default':
        $form['actions']['submit']['#value'] = t('SUBSCRIBE & SAVE');
      break;
    }
  }
  $checkout_forms = [
    'commerce_checkout_flow_multistep_default',
  ];
  if (in_array($form_id, $checkout_forms) && $form['#step_id'] != 'review') {
    //ksm($form['#step_id']);
    $form['#prefix'] = t('<span class="contact-payment-subscribe">Contact information.</span>');
    $form['order_fields:checkout']['field_address']['widget'][0]['address']['#after_build'][] = 'al_dia_news_general_customize_address';


  }

}

function callback_change_password(&$form, &$form_state){

  if (is_null($form['#children_errors'])){
    $response = new AjaxResponse();
    $redirect = new RedirectCommand('/?modal=1');
    $response->addCommand($redirect);
    return $response;
  }
  else {
    return $form;
  }
}

function custom_cancel_account(&$form, &$form_state) {
  $form_state->setRedirect('<front>');
}
  /**
 * @return \Drupal\Core\Ajax\AjaxResponse
 */
function closeModalForm() {
  $command = new CloseModalDialogCommand();
  $response = new AjaxResponse();
  $response->addCommand($command);
  return $response;
}

