/**
 * Implements hook_node_view()
 */
 function al_dia_news_general_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, $view_mode) {

  $content_type = $node->get('type')->getString();

  //if($vid == 59){
  if ($content_type == "news") {
    $strBody = $node->get('body')->value;
    $count = substr_count($strBody, '<div data-embed-button="related_content">');

    $block_id = 'views_block__related_content_block_1';
    //$block = \Drupal\block\Entity\Block::load($block_id);

    $con = \Drupal\block\BlockViewBuilder::lazyBuilder($block_id, 'full');
    $d   = \Drupal::service('renderer')->renderPlain($con);
    $html_block = $d->__toString();

    $newHtml = newHtml($strBody, $html_block);

    //$node->body->value = '';
    //$strBody = $node->get('body')->value;
    //ksm($node->get('body')->value);



      
    ksm($strBody);
    ksm($content_type);
    //$node->body->value = $newHtml;
    //$node->save();


      
    //ksm($newHtml);
    //ksm($node->body->values);
      
    //$build['body'][0]['#text'];

    if (isset($node->body) && $newHtml != false) {

      // Vaciamos los valores

  
      //$format = $node->get('body')->format;
      $format = 'full_html';


      // Copy the values to the new fields, being careful not to wipe out other values that might be there.
      $node->body->setValue(['value' => $newHtml, 'format' => $format]);

      // Clear the body values.
      //
      // Force a node save even if there are no changes to force the pre_save hook to be executed.
      $node->save();

    }

  }

    function newHtml($html_body, $html_block){
      
      $dom = new DomDocument;
      $dom->loadHTML($html_body);

      $count_related = 0;
      foreach($dom->getElementsByTagName('div') as $item){
        $count_related++;
      }

      $count_p = 0;
      foreach($dom->getElementsByTagName('p') as $item){
        $count_p++;
      }

      //return $count_related;

      $position = intval($count_p / 2);
      

      if($count_p != 1){
      if($position % 2 == 0){
        
        $par = true;
      }else{
        $par = false;
        $position = $position + 1;
      }
      }else{
        $par = null;
      }

      
      
      
      //$dom->getElementsByTagName('p')->item(0)->nodeValue = $dom->getElementsByTagName('p')->item(0)->nodeValue."[related-content]";
      if($count_related == 0){

        $count = 1;
        foreach ($dom->getElementsByTagName('p') as $paragraph) {
          //echo "encontré un párrafo. \n";
          if ($position == $count){
            //$paragraph->parentNode->removeChild($paragraph);
            $paragraph->nodeValue = $paragraph->nodeValue."[related-content]";
          }
          $count++;
        }
        
          $html = $dom->saveHtml();
        
          $related_content = "</p><div data-embed-button='related_content'>". $html_block ."</div>";
        
          $html = str_replace("[related-content]</p>", $related_content, $html);
        
          return $html;

      }else{

        return false;

      }
    }
  
    
}

/**
 * Implement hook_views_query_alter.
 *
 * Se usa para alterar la consulta sql de la vista.
 *
 * @param view propiedades de la vista
 * @param query consulta sql de la vista
 */
function al_dia_news_general_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  switch ($view->id()) {
    case 'last_news':
      if ($view->getDisplay()->display['id'] == 'block_1') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_2') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_3') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->innerJoin("taxonomy_term_field_data", "ttfd", "ttp.parent_target_id = ttfd.tid");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $query1->range(0, 5);
          $results = $query1->execute()->fetchCol();
          if($results){
            foreach ($query->where as &$condition_group) {
              foreach ($condition_group['conditions'] as &$condition) {
                if($condition["field"] == "node_field_data.nid"){
                  $condition["value"] = $results;
                  $condition["operator"] = "NOT IN";
                }
              }
            }
          }
        }
      }
      if ($view->getDisplay()->display['id'] == 'block_4') {
        $current_path = \Drupal::service('path.current')->getPath();
        $path_args = explode('/', $current_path);
        if ($path_args[1] == 'taxonomy' && is_numeric($path_args[3])) {
          $database = \Drupal::database();
          $query1 = $database->select('node_field_data', 'nfd');
          $query1->addField("nfd", "nid");
          $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
          $query1->leftJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
          $query1->leftJoin("taxonomy_term__parent", "ttp", "tfd.tid = ttp.entity_id");
          $query1->condition("ttp.parent_target_id", $path_args[3], "=");
          $query1->condition("nfd.type", "news", "=");
          $query1->condition("nfd.status", 1, "=");
          $query1->range(0, 5);
          $query1->distinct();
          $query1->orderBy("nfd.created", "DESC");
          $results = $query1->execute()->fetchCol();
          if($results){
            $query2 = $database->select('taxonomy_term__parent', 'ttp');
            $query2->addField("ttp", "entity_id");
            $query2->condition("ttp.parent_target_id", $path_args[3], "=");
            $hijos = $query2->execute();
            $nids = $results;
            foreach ($hijos as $hijo){
              $query1 = $database->select('node_field_data', 'nfd');
              $query1->addField("nfd", "nid");
              $query1->leftJoin("node__field_category", "nfc", "nfd.nid = nfc.entity_id");
              $query1->innerJoin("taxonomy_term_field_data", "tfd", "nfc.field_category_target_id = tfd.tid");
              $query1->condition("tfd.tid", $hijo->entity_id, "=");
              $query1->condition("nfd.type", "news", "=");
              $query1->condition("nfd.status", 1, "=");
              $query1->condition("nfd.nid", $nids, "NOT IN");
              $query1->distinct();
              $query1->orderBy("nfd.created", "DESC");
              $query1->range(0, 9);
              $results = $query1->execute()->fetchCol();
              if ($results){
                $nids = array_merge( $nids, $results);
              }
            }
            if($nids){
              foreach ($query->where as &$condition_group) {
                foreach ($condition_group['conditions'] as &$condition) {
                  if($condition["field"] == "node_field_data.nid"){
                    $condition["value"] = $nids;
                    $condition["operator"] = "NOT IN";
                  }
                }
              }
            }
          }
        }
      }
    break;
  }
   
}
