function al_dia_news_general_theme() {
  return [
    'anonymous_comment_form' => [
      'variables' => [],
    ],
    'icons_custom' => [
      'variables' => [
        'value' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_element_info_alter().
 */
function al_dia_news_general_element_info_alter(array &$info) {
  if (isset($info['password_confirm'])) {
    $info['password_confirm']['#after_build'][] = 'al_dia_news_general_after_build';
  }
}

/**
 * After build function for password_confirm elements.
 *
 * @param array $element
 *   The element being altered after build.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form_state object returned with the element.
 */
function al_dia_news_general_after_build(array $element, FormStateInterface $form_state) {
  $element['pass1']['#required'] = TRUE;
  $element['pass2']['#required'] = TRUE;
  return $element;

}

/**
 * Implements hook_editor_js_settings_alter().
 */
function al_dia_news_general_editor_js_settings_alter(array &$settings) {
  if (!empty($settings['editor']['formats']['full_html'])) {
    $full_html = &$settings['editor']['formats']['full_html'];
    $full_html['editorSettings']['forcePasteAsPlainText'] = TRUE;
		$full_html['editorSettings']['pasteFilter'] = 'plain-text';
		$full_html['editorSettings']['allowedContent'] = TRUE;
		$full_html['editorSettings']['pasteFromWordPromptCleanup'] = FALSE;

    //$full_html['editorSettings']['bodyClass'] = "al_dia_news_general/custom_css";
    $full_html['editorSettings']['#attached']['library'][] = 'al_dia_news_general/custom_css';
	}
}

/**
 * Implements hook_ckeditor_css_alter().
 */
function al_dia_news_general_ckeditor_css_alter(array &$css, Editor $editor) {
  $css[] = drupal_get_path('module', 'al_dia_news_general') . '/src/css/custom.css';
}

function al_dia_news_general_preprocess_block(&$vars) {
	$vars['#cache']['max-age'] = 0;

	if (is_mobile()) {
    $vars['device'] = 'mobile';
  } else {
    $vars['device'] = 'desktop';
  }
}

function al_dia_news_general_preprocess_node(&$vars) {
	$node = $vars['node'];
	$nodeType = $node->getType();

	if($nodeType == "news"){
		$fields = $node->getFields();
		$field_type = $fields['field_type_of_content'];
		$field_type_entity = $field_type->entity;

     
		if($field_type_entity->getName() !== null ){
			if(strtolower($field_type_entity->getName()) == 'video'){
				$vars['attributes']['class'][] = 'node_has_video';
			}else {
				$vars['attributes']['class'][] = 'node_has_image';
			}

		}

	}

}
