# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
# /web/themes/contrib/
/web/profiles/contrib/

# Ignore sensitive information
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Ignore Drupal's file directory
/web/sites/*/files/
/web/sites/*

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/
/.env

# Ignore files generated by VSCode
.vscode


# Ignore SQL files
/mariadb-init/*.sql

# Ignore files and directories by front
node_modules
/web/themes/custom/**/package-lock.json
/web/themes/custom/**/styleguide/

#other files and folders
.DS_Store
nbproject
*.sql
*.sql.gz
*.bk
*.bak
/nbproject/private/

#ignore lando files
.editorconfig
.gitattributes
.gitignore
