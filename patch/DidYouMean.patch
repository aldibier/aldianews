+
+
+  /**
+   * Performs a redirection to fixed link.
+   *
+   * @param string $new_keys
+   *   The suggestion.
+   * @param string $filter_name
+   *   The parameter name of text search filter.
+   * @param string $keys
+   *   The original word
+   *
+   * @return \Drupal\Core\Link
+   *   The suggestion link.
+   */
+  protected function redirectToSuggestion($new_keys, $filter_name, $keys)
+  {
+
+      if (!$this->view->hasUrl()) {
+          // On any non views.ajax route, use the current route for the form action.
+          if ($this->getRouteMatch()->getRouteName() !== 'views.ajax') {
+              $url = Url::fromRoute(
+                  '<current>',
+                  [$filter_name => $new_keys] + $this->getCurrentQuery()
+              );
+          } else {
+              // On the views.ajax route, set the action to the page we were on.
+              $url = Url::fromUserInput(
+                  $this->currentPathStack->getPath(),
+                  [$filter_name => $new_keys] + $this->getCurrentQuery()
+              );
+          }
+      } else {
+          $view_url = $this->view->getUrl();
+          $view_route = $view_url->getRouteName();
+          $params = $this->getCurrentQuery();
+          // attach a param with original search
+          $suggested_params = [
+              'original_token' => $keys
+          ];
+          $url = Url::fromRoute(
+              $view_route,
+              [$filter_name => $new_keys] + $this->getCurrentQuery() + $suggested_params
+          );
+      }
+
+      return $url->toString();
+  }
 }
